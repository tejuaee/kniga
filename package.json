{
  "name": "kniga",
  "version": "0.1.0",
  "private": true,
  "description": "KNIGA — a social network for books. Log what you read, rate it, review it.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test \"server/**/*.test.js\"",
    "covers": "node --env-file-if-exists=.env server/fetch-covers.js"
  },
  "dependencies": {
    "express": "4.21.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.2",
    "concurrently": "9.0.1",
    "vite": "5.4.8"
  }
}
